"""ATS Resume Checker - Streamlit + Google Gemini Flash."""
import io
import json
import os
import re

import streamlit as st
from docx import Document
from google import genai
from google.genai import types
from pypdf import PdfReader

DEFAULT_MODEL = "gemini-2.5-flash"
MAX_CHARS = 20000  # keep prompts small and fast

SYSTEM_PROMPT = """You are an expert ATS (Applicant Tracking System) analyst and resume coach.
Evaluate the resume text and respond with ONLY valid JSON in this exact shape:
{
  "ats_score": <integer 0-100>,
  "summary": "<2-3 sentence overall assessment>",
  "category_scores": {
    "formatting": <0-100>,
    "keywords": <0-100>,
    "experience_impact": <0-100>,
    "education_skills": <0-100>,
    "readability": <0-100>
  },
  "strengths": ["..."],
  "issues": ["..."],
  "improvements": [
    {"section": "<resume section>", "suggestion": "<specific, actionable fix>", "example": "<short rewritten example>"}
  ],
  "missing_keywords": ["..."]
}
Be honest and specific. If a job description is provided, judge keyword match against it
and list missing keywords from it; otherwise judge against general industry norms."""


# ---------- helpers (kept free of UI code so they are easy to test) ----------
def extract_text(data: bytes, filename: str) -> str:
    name = filename.lower()
    if name.endswith(".pdf"):
        reader = PdfReader(io.BytesIO(data))
        text = "\n".join((page.extract_text() or "") for page in reader.pages)
    elif name.endswith(".docx"):
        doc = Document(io.BytesIO(data))
        parts = [p.text for p in doc.paragraphs]
        for table in doc.tables:
            for row in table.rows:
                parts.append(" | ".join(c.text for c in row.cells))
        text = "\n".join(parts)
    elif name.endswith(".txt"):
        text = data.decode("utf-8", errors="ignore")
    else:
        raise ValueError("Unsupported file type. Please upload a PDF, DOCX or TXT file.")
    return text.strip()


def parse_json_response(raw: str) -> dict:
    """Parse model output, tolerating markdown fences or extra text."""
    raw = (raw or "").strip()
    raw = re.sub(r"^```(?:json)?\s*|\s*```$", "", raw, flags=re.IGNORECASE)
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", raw, flags=re.DOTALL)
        if match:
            return json.loads(match.group(0))
        raise ValueError("The AI response was not valid JSON. Please try again.")


def _clamp(value, default=0) -> int:
    try:
        return max(0, min(100, int(round(float(value)))))
    except (TypeError, ValueError):
        return default


def normalize_result(data: dict) -> dict:
    """Guarantee every field exists with the right type so the UI never crashes."""
    cats = data.get("category_scores") or {}
    keys = ["formatting", "keywords", "experience_impact", "education_skills", "readability"]
    improvements = []
    for item in data.get("improvements") or []:
        if isinstance(item, dict):
            improvements.append({
                "section": str(item.get("section", "General")),
                "suggestion": str(item.get("suggestion", "")),
                "example": str(item.get("example", "")),
            })
        else:
            improvements.append({"section": "General", "suggestion": str(item), "example": ""})
    as_list = lambda v: [str(x) for x in v] if isinstance(v, list) else []
    return {
        "ats_score": _clamp(data.get("ats_score")),
        "summary": str(data.get("summary", "")),
        "category_scores": {k: _clamp(cats.get(k)) for k in keys},
        "strengths": as_list(data.get("strengths")),
        "issues": as_list(data.get("issues")),
        "improvements": improvements,
        "missing_keywords": as_list(data.get("missing_keywords")),
    }


def analyze_resume(resume_text: str, job_description: str, api_key: str, model: str) -> dict:
    client = genai.Client(api_key=api_key)
    prompt = f"RESUME:\n{resume_text[:MAX_CHARS]}\n"
    if job_description.strip():
        prompt += f"\nJOB DESCRIPTION:\n{job_description[:MAX_CHARS]}\n"
    response = client.models.generate_content(
        model=model,
        contents=prompt,
        config=types.GenerateContentConfig(
            system_instruction=SYSTEM_PROMPT,
            response_mime_type="application/json",
            temperature=0.2,
        ),
    )
    return normalize_result(parse_json_response(response.text))


def get_secret(name: str, default: str = "") -> str:
    try:
        if name in st.secrets:
            return str(st.secrets[name])
    except Exception:
        pass  # no secrets file locally
    return os.environ.get(name, default)


# ---------- UI ----------
def score_color(score: int) -> str:
    return "green" if score >= 75 else "orange" if score >= 50 else "red"


def main():
    st.set_page_config(page_title="ATS Resume Checker", page_icon="📄", layout="centered")
    st.title("📄 ATS Resume Checker")
    st.caption("Upload your resume to get an ATS score and tips to improve it.")

    api_key = get_secret("GEMINI_API_KEY")
    model = get_secret("GEMINI_MODEL", DEFAULT_MODEL)
    if not api_key:
        st.error("GEMINI_API_KEY is not set. Add it in Streamlit secrets or as an environment variable.")
        st.stop()

    uploaded = st.file_uploader("Upload resume (PDF, DOCX, TXT)", type=["pdf", "docx", "txt"])
    jd = st.text_area("Job description (optional, for a targeted score)", height=140)

    if st.button("Analyze resume", type="primary", disabled=uploaded is None):
        try:
            with st.spinner("Reading your resume..."):
                text = extract_text(uploaded.getvalue(), uploaded.name)
            if len(text) < 50:
                st.error("Couldn't extract enough text. If your PDF is a scanned image, "
                         "ATS systems can't read it either - export a text-based PDF.")
                st.stop()
            with st.spinner("Analyzing with Gemini..."):
                st.session_state["result"] = analyze_resume(text, jd, api_key, model)
        except Exception as e:
            st.error(f"Something went wrong: {e}")
            st.stop()

    result = st.session_state.get("result")
    if not result:
        return

    score = result["ats_score"]
    st.divider()
    st.markdown(f"## ATS Score: :{score_color(score)}[{score}/100]")
    st.progress(score / 100)
    st.write(result["summary"])

    st.subheader("Category scores")
    for name, val in result["category_scores"].items():
        st.write(name.replace("_", " ").title())
        st.progress(val / 100, text=f"{val}/100")

    col1, col2 = st.columns(2)
    with col1:
        st.subheader("✅ Strengths")
        for s in result["strengths"] or ["None identified"]:
            st.write(f"- {s}")
    with col2:
        st.subheader("⚠️ Issues")
        for s in result["issues"] or ["None identified"]:
            st.write(f"- {s}")

    st.subheader("🛠️ Suggested improvements")
    for imp in result["improvements"]:
        with st.expander(imp["section"]):
            st.write(imp["suggestion"])
            if imp["example"]:
                st.info(f"Example: {imp['example']}")

    if result["missing_keywords"]:
        st.subheader("🔑 Missing keywords")
        st.write(", ".join(result["missing_keywords"]))


if __name__ == "__main__":
    main()
